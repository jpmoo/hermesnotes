<?xml version="1.0" encoding="UTF-8"?>
<!--
  A bundle for a thing with no windows.

  Two separate reasons it has to exist, and they arrive at the same answer:

  - System Settings › Login Items names a background item after the *app
    responsible for it*, resolved through the code signature. A LaunchAgent
    pointing straight at /opt/homebrew/bin/node has no bundle to be responsible
    for it, so it is listed as "Node" — accurate and useless.

  - CoreSpotlight (Phase 2) refuses to index from an executable whose bundle id
    it can't resolve: it fails with -1003 and `corespotlightd` logging "Could not
    resolve bundle id", at index time rather than at call time, so the code looks
    like it worked.

  LSUIElement keeps it out of the Dock and the app switcher. It is a daemon
  wearing a bundle, not an app.

  LSBackgroundOnly used to sit alongside it, and that was wrong. It is the
  stronger claim — that the process presents no interface at all — so macOS
  creates the status item and then declines to draw it. The log saying the item
  was installed while the menu bar never showed it is a maddening pair of facts
  to hold at once, and this was why.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Talaria</string>
  <key>CFBundleDisplayName</key>
  <string>Talaria</string>
  <key>CFBundleIdentifier</key>
  <string>dev.talaria.Talaria</string>
  <key>CFBundleExecutable</key>
  <string>Talaria</string>
  <key>CFBundleIconFile</key>
  <string>Talaria</string>
  <!-- The asset catalog's icon set. This is the one current macOS looks for;
       CFBundleIconFile above stays for anything still reading the old key. -->
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <!-- Where the daemon's code lives; stamped in by build.sh, since the bundle
       is assembled outside the repo and cannot find it by looking around. -->
  <key>TalariaRepoRoot</key>
  <string>__REPO_ROOT__</string>

  <key>LSUIElement</key>
  <true/>

  <!--
    The URL scheme. Not `hermes`: that is another tool on this machine.

    Its job is host-independence. An https link to a block names a server, so
    every one ever pasted into a note dies the day that server moves; a
    talaria:// link is resolved by the daemon at click time, out of the one
    config file that knows where Hermes lives.

    Note that Spotlight does NOT come through here — activating a result calls
    the app back with the item's identifier instead. This is for links pasted
    into other apps, Shortcuts, and `open talaria://block/<uuid>`.
  -->
  <!--
    A macOS Service. This is what puts "New Hermes Task" in the Services
    submenu of the right-click menu in every app that can hand over text —
    Mail, Safari, Notes, an editor, anything using the standard text system.

    NSSendTypes says we take a string and NSReturnTypes is absent because we
    give nothing back: the selection stays where it is and a task appears.
    NSMessage names the selector on whatever is registered as the services
    provider, and NSRequiredContext keeps it out of menus where there is no
    text to send.
  -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict><key>default</key><string>Add to Hermes as Task</string></dict>
      <key>NSMessage</key>
      <string>captureAsTask</string>
      <key>NSPortName</key>
      <string>Talaria</string>
      <key>NSSendTypes</key>
      <array>
        <string>NSStringPboardType</string>
        <string>public.utf8-plain-text</string>
      </array>
      <key>NSRequiredContext</key>
      <dict><key>NSTextContent</key><string>Text</string></dict>
    </dict>
    <dict>
      <key>NSMenuItem</key>
      <dict><key>default</key><string>Add to Hermes as Note</string></dict>
      <key>NSMessage</key>
      <string>captureAsNote</string>
      <key>NSPortName</key>
      <string>Talaria</string>
      <key>NSSendTypes</key>
      <array>
        <string>NSStringPboardType</string>
        <string>public.utf8-plain-text</string>
      </array>
      <key>NSRequiredContext</key>
      <dict><key>NSTextContent</key><string>Text</string></dict>
    </dict>
  </array>

  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>dev.talaria.block</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>talaria</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
