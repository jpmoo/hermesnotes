{
  "name": "hermes-notes",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "Hermes Notes v2 \u2014 a block-first PKMS",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "start": "pnpm --filter @hermes/server start",
    "typecheck": "pnpm -r typecheck",
    "dev:server": "pnpm --filter @hermes/server dev",
    "dev:web": "pnpm --filter @hermes/web dev",
    "db:generate": "pnpm --filter @hermes/db generate",
    "db:migrate": "pnpm --filter @hermes/db migrate",
    "lint": "pnpm -r lint",
    "series:backfill": "pnpm --filter @hermes/db series:backfill",
    "check": "pnpm --filter @hermes/interchange check"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
