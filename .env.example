# ── Hermes Notes v2 — server environment ──────────────────────────────
# All of DATABASE_URL and AUTH_SECRET are OPTIONAL. On first run with neither
# set, the web app shows a setup wizard that provisions PostgreSQL and persists
# the connection + a generated auth secret to data/hermes.config.json.
# Set them here only if you'd rather configure the server without the wizard.

# PostgreSQL app connection (must have the pgvector `vector` extension). If unset,
# established by the first-run wizard.
# DATABASE_URL=postgres://hermes:CHANGE_ME@localhost:5432/hermes

# Session / token signing. Generate with: openssl rand -base64 48
# If unset, auto-generated and persisted to data/hermes.config.json on first run.
# AUTH_SECRET=CHANGE_ME_min_32_bytes

# HTTP server
PORT=3000
HOST=0.0.0.0

# Public origin of the web app (for CORS + cookie domain)
APP_ORIGIN=http://localhost:5173

# Zero-padded width for the ANN index (see architecture doc §Embeddings).
# Must be >= the largest embed-model dimension any user will select. 2000 is
# the pgvector HNSW ceiling and comfortably covers all common Ollama models.
EMBEDDING_INDEX_DIM=2000

# Optional: override where the first-run config file is written.
# HERMES_CONFIG_PATH=/var/lib/hermes/hermes.config.json
