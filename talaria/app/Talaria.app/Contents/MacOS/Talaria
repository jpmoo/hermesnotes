#!/bin/sh
# The bundle's executable: it runs the daemon, and exists so that macOS has
# something with a name to attribute the background item to.
#
# It resolves the repo from its own location rather than hard-coding one, so the
# bundle can be copied to /Applications and still find the code.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
# .../Talaria.app/Contents/MacOS/Talaria -> .../talaria
ROOT="$(cd "$(dirname "$SELF")/../../../.." && pwd)"
NODE="/opt/homebrew/bin/node"
exec "$NODE" "$ROOT/packages/daemon/node_modules/tsx/dist/cli.mjs" "$ROOT/packages/daemon/src/index.ts"
