{
  "suite": "derivation",
  "level": 2,
  "about": "Collections whose membership is computed rather than stated. The failure this suite exists to prevent is a live query being silently frozen into stale facts.",
  "cases": [
    {
      "id": "derivation/query-members-are-not-authoritative",
      "level": 2,
      "op": "roundtrip",
      "given": {
        "collection": {
          "membership": {
            "mode": "query",
            "materialized": false,
            "query": {
              "match": "all",
              "conditions": [
                {
                  "field": "status",
                  "op": "eq",
                  "value": "doing"
                }
              ]
            }
          },
          "members": [
            "o_1",
            "o_2"
          ]
        }
      },
      "when": {
        "reexport": true
      },
      "expect": {
        "result": {
          "membership": {
            "mode": "query",
            "materialized": false
          }
        }
      },
      "why": "The members array is a convenience snapshot for consumers that cannot run the query. Re-exporting it as an explicit collection converts a rule into two frozen facts, and the user's smart list stops updating without ever announcing that it has."
    },
    {
      "id": "derivation/materialized-query-is-authoritative",
      "level": 2,
      "op": "roundtrip",
      "given": {
        "collection": {
          "membership": {
            "mode": "query",
            "materialized": true,
            "query": {
              "match": "all",
              "conditions": []
            }
          },
          "members": [
            "o_1",
            "o_2"
          ]
        }
      },
      "when": {
        "reexport": true
      },
      "expect": {
        "result": {
          "members": [
            "o_1",
            "o_2"
          ]
        }
      },
      "why": "A materialized query ran once and its result was deliberately fixed. The members are real. The query is retained as provenance — how this set came to be — not as a live rule."
    },
    {
      "id": "derivation/downgrade-must-be-reported",
      "level": 2,
      "op": "import",
      "given": {
        "collection": {
          "membership": {
            "mode": "query",
            "materialized": false
          }
        }
      },
      "when": {
        "importInto": "a tool with no query engine"
      },
      "with": {
        "query": false
      },
      "simulated": true,
      "expect": {
        "fidelity": "reduced",
        "reports": [
          "query"
        ],
        "result": {
          "membership": {
            "mode": "explicit"
          }
        }
      },
      "why": "Importing a live query as a fixed list is permitted, because refusing the import outright helps nobody. Doing it quietly is not: the user believes they still have a smart collection."
    },
    {
      "id": "derivation/unknown-condition-preserved",
      "level": 2,
      "op": "roundtrip",
      "given": {
        "collection": {
          "membership": {
            "mode": "query",
            "materialized": false,
            "query": {
              "match": "all",
              "conditions": [
                {
                  "kind": "semantic",
                  "value": "things about the roof",
                  "floor": 0.75
                }
              ]
            }
          }
        }
      },
      "when": {
        "importInto": "a tool with no semantic search",
        "reexport": true
      },
      "with": {
        "conditions": [
          "property",
          "tag"
        ]
      },
      "expect": {
        "result": {
          "membership": {
            "query": {
              "conditions": [
                {
                  "kind": "semantic",
                  "value": "things about the roof",
                  "floor": 0.75
                }
              ]
            }
          }
        }
      },
      "why": "A consumer that cannot evaluate a condition must still carry it through untouched. Query languages will diverge faster than anything else in this format, and round-tripping the parts you do not understand is what stops that divergence from being lossy."
    },
    {
      "id": "derivation/empty-result-is-not-empty-collection",
      "level": 2,
      "op": "import",
      "given": {
        "collection": {
          "membership": {
            "mode": "query",
            "materialized": false
          },
          "members": []
        }
      },
      "when": {
        "importInto": "a tool with no query engine"
      },
      "with": {
        "query": false
      },
      "simulated": true,
      "expect": {
        "fidelity": "reduced",
        "reports": [
          "query"
        ]
      },
      "why": "A query that currently matches nothing is not the same as a collection that is empty. Importing it as an ordinary empty collection loses a rule, and the reduced-fidelity report is the only signal the user gets."
    },
    {
      "id": "derivation/a-bare-id-is-a-member",
      "level": 2,
      "op": "roundtrip",
      "given": {
        "collection": {
          "membership": {
            "mode": "explicit"
          },
          "members": [
            "o_1",
            {
              "object": "o_2",
              "position": "a0"
            }
          ]
        }
      },
      "expect": {
        "result": {
          "members": [
            {
              "object": "o_2",
              "position": "a0"
            }
          ]
        }
      },
      "why": "Both spellings mean the same member, and a consumer that expands the short one has lost nothing. This case exists because a round-trip through a real implementation came back structurally different for exactly this reason, and a rule that reads as absolute — do not normalise — needs its one exception written down rather than argued about."
    }
  ]
}
