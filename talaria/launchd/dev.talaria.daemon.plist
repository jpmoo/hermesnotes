<?xml version="1.0" encoding="UTF-8"?>
<!--
  Install:  cp this to ~/Library/LaunchAgents/ and
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.talaria.daemon.plist

  Two things launchd is fussy about, both deliberate here:

  - ProgramArguments uses ABSOLUTE paths, and names tsx's JavaScript entry point rather
    than the `.bin/tsx` shell wrapper, which node cannot execute. A
    LaunchAgent gets almost none of a login shell's environment: there are three
    node installs on this Mac and PATH decides between them, so leaving the
    choice to PATH means leaving it to whatever launchd happens to hand over.
    /opt/homebrew/bin/node is v26.5.0 and the acceptance suite passes on it.
  - KeepAlive is conditional on a clean exit rather than unconditional. The
    daemon exits 78 (EX_CONFIG) when its config is missing or wrong, and
    restarting that forever would turn one clear error into a log full of them.
    launchd can only tell zero from non-zero, so this has a cost worth knowing:
    a daemon stopped by SIGTERM exits 0 and stays stopped until the next login.
    That is the right answer when you meant to stop it and the wrong one when
    something else stopped it for you — `talaria doctor` is what tells the
    difference, so it is worth running when the mirror looks frozen.

  Restart it after a code change with:
    launchctl kickstart -k gui/$(id -u)/dev.talaria.daemon
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.talaria.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/jpmoore/Documents/Misc/Scripts/hermesnotes/talaria/packages/daemon/node_modules/tsx/dist/cli.mjs</string>
    <string>/Users/jpmoore/Documents/Misc/Scripts/hermesnotes/talaria/packages/daemon/src/index.ts</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/jpmoore/Library/Logs/talaria.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jpmoore/Library/Logs/talaria.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/jpmoore/Documents/Misc/Scripts/hermesnotes</string>
</dict>
</plist>
