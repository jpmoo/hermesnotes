                "kind": "enum",
                "options": [
                  "todo",
                  "doing",
                  "on hold",
                  "done",
                  "dropped"
                ]
              }
            ],
            "profiles": {
              "task": {
                "title": "title",
                "status": "stage",
                "completeValues": [
                  "done",
                  "dropped"
                ],
                "states": {
                  "todo": "not-started",
                  "working": "in-progress",
                  "done": "done",
                  "dropped": "cancelled"
                }
              }
            }
          }
        ]
      },
      "expect": {
        "valid": false,
        "errors": [
          {
            "code": "profile.state-not-an-option"
          }
        ]
      },
      "why": "A state for an option the status field does not have describes a status no task can hold — and hides that the real one, here \"doing\", has none."
    },
    {
      "id": "profile/a-state-is-one-of-the-five",
      "level": 1,
      "op": "validate",
      "given": {
        "types": [
          {
            "id": "t_job",
            "name": "Job",
            "fields": [
              {
                "key": "title",
                "kind": "text"
              },
              {
                "key": "stage",
                "kind": "enum",
                "options": [
                  "todo",
                  "doing",
                  "on hold",
                  "done",
                  "dropped"
                ]
              }
            ],
            "profiles": {
              "task": {
                "title": "title",
                "status": "stage",
                "completeValues": [
                  "done",
                  "dropped"
                ],
                "states": {
                  "todo": "not-started",
                  "doing": "started",
                  "done": "done",
                  "dropped": "cancelled"
