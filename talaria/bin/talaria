#!/bin/sh
# The `talaria` command.
#
# Not `hermes`: that name is already taken on this machine by Hermes Agent
# (Nous Research), an unrelated tool. The brief asked for `hermes` but also
# called the health check `talaria doctor`; this settles it the consistent way.
#
# A shell script rather than an alias so it works from anything that isn't an
# interactive zsh — Shortcuts, Raycast, cron, a Keyboard Maestro macro — all of
# which are the point of this project and none of which read your .zshrc.
#
# It names tsx's JavaScript entry point, not the `.bin/tsx` wrapper: that
# wrapper is a shell script, and handing it to node produces a syntax error
# rather than anything that looks like a missing runtime.
# Absolute paths first, then PATH. The reason for hardcoding one at all is that
# a LaunchAgent's PATH is not your shell's — and a systemd user unit's is
# shorter still, so the problem did not go away by changing platform. But a
# single hardcoded path is wrong on every machine that is not the author's, so
# the list is tried in order and $TALARIA_NODE overrides the lot.
for candidate in \
  "$TALARIA_NODE" \
  /opt/homebrew/bin/node \
  /usr/local/bin/node \
  "$HOME/.local/bin/node" \
  /usr/bin/node
do
  [ -n "$candidate" ] && [ -x "$candidate" ] && NODE="$candidate" && break
done
# Last resort, and it will work from an interactive shell even when nothing
# above does. Left last rather than first precisely because the callers that
# matter here — a hotkey, a systemd unit, KRunner — are the ones without it.
[ -n "$NODE" ] || NODE="$(command -v node)"
[ -n "$NODE" ] || { echo "talaria: no node found (set \$TALARIA_NODE)" >&2; exit 1; }

# Follow symlinks to find where this script actually lives. The intended install
# is a symlink from somewhere on PATH, so $0 is usually the link and not the
# file — taking dirname of it would look for the repo next to the link.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"

exec "$NODE" "$ROOT/packages/cli/node_modules/tsx/dist/cli.mjs" "$ROOT/packages/cli/src/index.ts" "$@"
