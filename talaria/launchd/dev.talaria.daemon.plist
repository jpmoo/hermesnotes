<?xml version="1.0" encoding="UTF-8"?>
<!--
  Install:  cp this to ~/Library/LaunchAgents/ and
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.talaria.daemon.plist

  Two things launchd is fussy about, both deliberate here:

  - ProgramArguments points at an app bundle's executable rather than straight
    at node. System Settings › Login Items names a background item after the app
    responsible for it, resolved through the code signature — with no bundle to
    be responsible, the item is listed as "Node", which is accurate and useless.
    The bundle also gives CoreSpotlight (Phase 2) a bundle id it can resolve;
    without one it refuses to index, at index time rather than at call time.

    The bundle's executable picks the absolute node itself. There are three node
    installs on this Mac and PATH decides between them, and PATH is exactly what
    a LaunchAgent does not reliably get.
  - KeepAlive is unconditional: whatever stops the daemon, it comes back. A
    mirror that is quietly not running is the failure this whole layer exists to
    avoid, and launchd cannot tell "someone stopped it on purpose" from "it was
    stopped for you" — it only sees zero or non-zero.

    The cost is that a genuinely bad config respawns forever. ThrottleInterval
    holds that to once a minute rather than once every ten seconds, so the log
    stays readable and the message stays findable. Recovery after a fix is a
    minute at most.

    Because this restarts on a clean exit too, `kill` won't stop it. To actually
    stop it: launchctl bootout gui/$(id -u)/dev.talaria.daemon

  Restart it after a code change with:
    launchctl kickstart -k gui/$(id -u)/dev.talaria.daemon
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.talaria.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/jpmoore/Library/Application Support/Talaria/Talaria.app/Contents/MacOS/Talaria</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- Seconds between respawns. The default of 10 turns a bad config into six
       copies of the same error a minute; this makes it one. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardOutPath</key>
  <string>/Users/jpmoore/Library/Logs/talaria.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jpmoore/Library/Logs/talaria.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/jpmoore/Documents/Misc/Scripts/hermesnotes</string>
</dict>
</plist>
