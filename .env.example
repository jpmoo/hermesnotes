# ── Hermes Notes v2 — server environment ──────────────────────────────
# All of DATABASE_URL and AUTH_SECRET are OPTIONAL. On first run with neither
# set, the web app shows a setup wizard that provisions PostgreSQL and persists
# the connection + a generated auth secret to data/hermes.config.json.
# Set them here only if you'd rather configure the server without the wizard.

# PostgreSQL app connection (must have the pgvector `vector` extension). If unset,
# established by the first-run wizard.
# DATABASE_URL=postgres://hermes:CHANGE_ME@localhost:5432/hermes

# Session / token signing. Generate with: openssl rand -base64 48
# If unset, auto-generated and persisted to data/hermes.config.json on first run.
# AUTH_SECRET=CHANGE_ME_min_32_bytes

# HTTP server — the app is served (API + web) on this port.
PORT=3000
HOST=0.0.0.0

# Public origin of the web app (scheme + host, NO path), for CORS + cookies.
APP_ORIGIN=http://localhost:3000

# Where the app is hosted. Leave unset to serve at the root of the origin
# (http://host:PORT/). Only set these to host under a subpath behind a reverse
# proxy — both must agree, e.g. for example.com/notes:
#   APP_BASE_PATH=/notes/                         # build-time base for the web app
#   PUBLIC_BASE=https://example.com/notes         # full public URL (OAuth/MCP)
# APP_BASE_PATH=/
# PUBLIC_BASE=

# Where days begin and end for anyone who hasn't set their own timezone —
# an account made over the API, or one made before sign-up asked. Everything
# the server decides for itself reads it: which day a note belongs to when an
# agent writes one, what "today" means in a saved query, the Today sheet's
# activity window.
#
# Unset, the answer is this machine's clock, which says where the server is
# hosted rather than where you are: a box running UTC is already on tomorrow's
# date from early evening in the Americas, which is enough to file a note under
# the wrong day. An IANA name, e.g. America/New_York.
# DEFAULT_TIMEZONE=

# Zero-padded width for the ANN index (see architecture doc §Embeddings).
# Must be >= the largest embed-model dimension any user will select. 2000 is
# the pgvector HNSW ceiling and comfortably covers all common Ollama models.
EMBEDDING_INDEX_DIM=2000

# Optional: override where the first-run config file is written.
# HERMES_CONFIG_PATH=/var/lib/hermes/hermes.config.json
