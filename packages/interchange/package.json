{
  "name": "@hermes/interchange",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "tsx probe.ts",
    "measure": "tsx measure.ts",
    "roundtrip": "tsx roundtrip.ts",
    "foreign": "tsx foreign.ts ../../pkm-interchange/example/library.json",
    "check": "tsx regioncheck.ts && tsx measure.ts && tsx probe.ts /tmp/hermes-export.json && node ../../pkm-interchange/check/src/cli.js /tmp/hermes-export.json && tsx roundtrip.ts && tsx narrowcheck.ts",
    "narrowcheck": "tsx narrowcheck.ts",
    "regioncheck": "tsx regioncheck.ts"
  },
  "dependencies": {
    "@hermes/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2"
  }
}
