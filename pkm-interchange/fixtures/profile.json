      },
      "why": "The five are the vocabulary; a sixth word is a private one, and a consumer reading it has nothing to match it to."
    },
    {
      "id": "profile/finished-states-agree-with-complete-values",
      "level": 1,
      "op": "validate",
      "given": {
        "types": [
          {
            "id": "t_job",
            "name": "Job",
            "fields": [
              {
                "key": "title",
                "kind": "text"
              },
              {
                "key": "stage",
