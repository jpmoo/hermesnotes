# Hermes MCP server — systemd unit.
# Install once:
#   sudo cp docs/hermes-mcp.service /etc/systemd/system/hermes-mcp.service
#   (edit User/WorkingDirectory below if your paths differ)
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hermes-mcp
[Unit]
Description=Hermes Notes MCP server
After=network.target hermesnotes.service
Wants=hermesnotes.service

[Service]
Type=simple
User=jpmoore
WorkingDirectory=/home/jpmoore/hermesnotes
Environment=HERMES_API=http://127.0.0.1:3000/api
Environment=MCP_PORT=8082
Environment=MCP_HOST=127.0.0.1
ExecStart=/usr/bin/env pnpm --filter @hermes/mcp start
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
